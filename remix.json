{
  "$schema": "./node_modules/remix/schema/remix.json",
  "assets": {
    "rootDir": ".",
    "basePath": "/assets",
    "mounts": {
      "app": "app",
      "npm": "node_modules"
    },
    "allowFiles": [
      "app/**/public/**",
      "app/ui/**",
      "app/assets/entry.tsx",
      "app/assets/frame-response.browser.tsx",
      "app/assets/error-card.browser.tsx",
      "app/routes.ts",
      "app/utils/**"
    ],
    "allowPackages": ["@remix-run/ui", "remix"],
    "denyFiles": ["app/**/*.server.*", "app/**/*.test.*"]
  },
  "test": {
    "concurrency": 6,
    "pool": "forks",
    "files": ["**/*.test{,.browser,.e2e}.{ts,tsx}"],
    "browserFiles": ["**/*.test.browser.{ts,tsx}"],
    "e2eFiles": ["**/*.test.e2e.{ts,tsx}"],
    "exclude": [],
    "playwright": {
      "echo": false,
      "open": false,
      "configFile": "./playwright.config.ts",
      "projects": ["chromium", "firefox"]
    },
    "reporter": "spec",
    "setup": "./test/setup.ts",
    "coverage": {
      // Local runs stay fast; `npm test -- --coverage` enables these settings
      // (CI runs that same command). Shared test helpers live in test/, so
      // app/** is production code only.
      "enabled": false,
      "dir": ".coverage",
      "include": ["app/**/*.{ts,tsx}"],
      "exclude": [
        "app/**/*.test{,.browser,.e2e}.{ts,tsx}",
        // Test-only helper colocated with the verwaltung controller; the
        // *.test.* exclude glob does not match its .test-utils. name.
        "app/actions/verwaltung/controller.test-utils.ts"
      ],
      "statements": 80,
      "lines": 80,
      "branches": 70,
      "functions": 80
    },
    "type": ["server", "browser", "e2e"],
    "watch": false
  }
}
