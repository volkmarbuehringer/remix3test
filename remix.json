{
  "$schema": "./node_modules/remix/schema/remix.json",
  "assets": {
    "rootDir": ".",
    "basePath": "/assets",
    "mounts": {
      "app": "app",
      "node_modules": "node_modules"
    },
    "allowFiles": [
      "app/**/public/**",
      "app/ui/**",
      "app/assets/entry.tsx",
      "app/assets/frame-response.browser.tsx",
      "app/assets/error-card.browser.tsx",
      "app/routes.ts",
      "app/utils/**"
    ],
    "allowPackages": ["remix"],
    "denyFiles": ["app/**/*.server.*", "app/**/*.test.*"]
  },
  "db": {
    "adapter": {
      "type": "postgres",
      "connectionString": { "env": "DATABASE_URL" }
    }
  },
  "test": {
    "concurrency": 6,
    "pool": "forks",
    "files": ["**/*.test{,.browser,.e2e}.{ts,tsx}"],
    "browserFiles": ["**/*.test.browser.{ts,tsx}"],
    "e2eFiles": ["**/*.test.e2e.{ts,tsx}"],
    "exclude": [],
    "playwright": {
      "echo": false,
      "open": false,
      "configFile": "./playwright.config.ts",
      "projects": ["chromium"]
    },
    "reporter": "spec",
    "setup": "./test/setup.ts",
    "type": ["server", "browser", "e2e"],
    "watch": false
  }
}
