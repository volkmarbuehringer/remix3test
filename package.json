{
  "name": "newapp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --watch-path=app --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node --env-file-if-exists=.env --import remix/node-tsx hmr.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "dev:bun": "NODE_ENV=development bun --watch server.bun.ts",
    "start:bun": "NODE_ENV=production bun server.bun.ts",
    "test": "NODE_ENV=test remix test",
    "test:bun": "NODE_ENV=test bun node_modules/remix/dist/cli-entry.js test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.bun.json --noEmit",
    "lint": "oxlint --max-warnings=0 --ignore-pattern=.mastra && node ./scripts/check-theme-conformance.ts",
    "dev:mastra": "mastra dev -d app/actions/mastra",
    "lint:fix": "oxlint --fix --max-warnings=0",
    "format": "oxfmt . --check",
    "format:fix": "oxfmt . --write",
    "sync-skills": "node ./scripts/sync-skills.ts",
    "postinstall": "node ./scripts/postinstall.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.67.0",
    "@mastra/evals": "^1.10.2",
    "@mastra/loggers": "^1.3.2",
    "@mastra/memory": "^1.30.0",
    "@mastra/observability": "^1.17.8",
    "@mastra/pg": "^1.25.0",
    "date-holidays": "^3.37.0",
    "nodemailer": "^10.0.10",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "remix": "github:remix-run/remix#preview/main&path:packages/remix",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.1",
    "@oxlint/plugins": "^1.85.0",
    "@types/bun": "^1.4.2",
    "@types/node": "26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "mastra": "^1.30.0",
    "openspec": "latest",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "playwright": "^1.63.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.2.0"
  },
  "packageManager": "pnpm@11.25.0"
}
