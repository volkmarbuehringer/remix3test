    "nodemailer": "^8.0.10",
    "pg": "^8.21.0",
    "remix": "next",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.4.0",
    "@opencode-ai/plugin": "^1.16.2",
    "ecc-universal": "next",
    "@ai-sdk/devtools": "^0.0.18",
    "@oxlint/plugins": "^1.68.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "typescript": "latest"
