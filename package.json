{
  "name": "newapp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "sync-skills": "node ./scripts/sync-skills.ts",
    "postinstall": "node ./scripts/postinstall.ts"
  },
  "engines": {
    "node": ">=26.2.0"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.50",
    "ai": "^6.0.205",
    "date-holidays": "^3.30.2",
    "nodemailer": "^9.0.00",
    "pdfmake": "^0.3.11",
    "pg": "^8.21.0",
    "remix": "github:remix-run/remix#preview/main&path:packages/remix",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^0.0.19",
    "@fission-ai/openspec": "^1.4.1",
    "@opencode-ai/plugin": "^1.17.3",
    "@oxlint/plugins": "^1.69.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.20.0",
    "@typescript/native-preview": "7.0.0-dev.20260614.1",
    "ecc-universal": "2.0.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.4",
    "typescript": "6.0.3"
  }
}
