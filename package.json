{
  "name": "newapp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --watch-path=app --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node --env-file-if-exists=.env --import remix/node-tsx hmr.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "test": "NODE_ENV=test remix test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings=0 --ignore-pattern=.mastra && node ./scripts/check-theme-conformance.ts",
    "dev:mastra": "mastra dev -d app/actions/mastra",
    "lint:fix": "oxlint --fix --max-warnings=0",
    "format": "oxfmt . --check",
    "format:fix": "oxfmt . --write",
    "sync-skills": "node ./scripts/sync-skills.ts",
    "postinstall": "node ./scripts/postinstall.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.64.0",
    "@mastra/evals": "^1.10.0",
    "@mastra/loggers": "^1.3.1",
    "@mastra/memory": "^1.28.2",
    "@mastra/observability": "^1.17.5",
    "@mastra/pg": "^1.22.3",
    "date-holidays": "^3.35.0",
    "nodemailer": "^9.1.1",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "remix": "github:remix-run/remix#preview/main&path:packages/remix",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.12.0",
    "@oxlint/plugins": "^1.81.0",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "mastra": "^1.27.3",
    "openspec": "latest",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.2.0"
  },
  "packageManager": "pnpm@11.25.0"
}
