{
  "name": "newapp",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --watch-path=app --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node --env-file-if-exists=.env --import remix/node-tsx hmr.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --import remix/node-tsx server.ts",
    "dev:bun": "NODE_ENV=development bun --watch server.bun.ts",
    "start:bun": "NODE_ENV=production bun server.bun.ts",
    "test": "npm run test:server && npm run test:browser && npm run test:e2e",
    "test:coverage": "rm -rf .coverage && NODE_ENV=test remix test --type server --type browser --type e2e --coverage --concurrency 2",
    "test:server": "NODE_ENV=test remix test --type server --concurrency 6",
    "test:browser": "NODE_ENV=test remix test --type browser --concurrency 3",
    "test:e2e": "NODE_ENV=test remix test --type e2e --concurrency 2",
    "test:mobile": "npm run test:mobile:browser && npm run test:mobile:pages",
    "test:mobile:browser": "PLAYWRIGHT_MOBILE=1 NODE_ENV=test remix test --type browser --concurrency 3 --project mobile-chrome --project mobile-safari-sized",
    "test:mobile:pages": "PLAYWRIGHT_MOBILE=1 NODE_ENV=test remix test --type e2e --concurrency 2 --project mobile-chrome --project mobile-safari-sized app/actions/home/home-nav-responsive.test.e2e.ts app/actions/mobile-route-matrix.test.e2e.ts app/actions/admin/admin-grids-responsive.test.e2e.ts app/actions/settings/settings-responsive.test.e2e.ts app/actions/auth/auth-responsive.test.e2e.ts",
    "test:bun": "NODE_ENV=test bun node_modules/remix/dist/cli-entry.js test --type server --concurrency 6 && NODE_ENV=test bun node_modules/remix/dist/cli-entry.js test --type browser --concurrency 3 && NODE_ENV=test bun node_modules/remix/dist/cli-entry.js test --type e2e --concurrency 2",
    "db:migrate": "node --env-file-if-exists=.env --import remix/node-tsx scripts/db.ts migrate",
    "db:status": "node --env-file-if-exists=.env --import remix/node-tsx scripts/db.ts status",
    "db:rollback": "node --env-file-if-exists=.env --import remix/node-tsx scripts/db.ts rollback",
    "db:reset": "node --env-file-if-exists=.env --import remix/node-tsx scripts/db.ts reset",
    "db:seed": "node --env-file-if-exists=.env --import remix/node-tsx scripts/db-seed.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.bun.json --noEmit",
    "typecheck:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters && tsc -p tsconfig.bun.json --noEmit --noUnusedLocals --noUnusedParameters",
    "typecheck:bun": "bun check && bun check -p tsconfig.bun.json",
    "lint": "oxlint --max-warnings=0 --ignore-pattern=.mastra && node ./scripts/check-theme-conformance.ts",
    "dev:mastra": "mastra dev -d app/actions/mastra",
    "eval:mastra": "node --env-file-if-exists=.env --import remix/node-tsx scripts/eval-mastra.ts",
    "lint:fix": "oxlint --fix --max-warnings=0",
    "format": "oxfmt . --check",
    "format:fix": "oxfmt . --write",
    "knip": "knip",
    "remix:pin:check": "node ./scripts/check-remix-pin.ts",
    "update:remix": "node ./scripts/update-remix.ts",
    "sync-skills": "node ./scripts/sync-skills.ts",
    "postinstall": "node ./scripts/postinstall.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.82.0",
    "@mastra/evals": "^1.10.11",
    "@mastra/loggers": "^1.3.10",
    "@mastra/memory": "^1.41.0",
    "@mastra/observability": "^1.23.1",
    "@mastra/pg": "^1.35.0",
    "@remix-run/ui": "https://github.com/remix-run/previews/releases/download/v0.20261111.171719-main-0cab1903/ui.tgz",
    "date-holidays": "^3.39.1",
    "nodemailer": "^10.5.0",
    "pdfmake": "^0.3.14",
    "pg": "^8.23.1",
    "remix": "https://github.com/remix-run/previews/releases/download/v0.20261111.171719-main-0cab1903/remix.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.17.0",
    "@oxlint/plugins": "^1.93.0",
    "@types/bun": "^1.4.4",
    "@types/node": "26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "html-validate": "^11.21.0",
    "knip": "^6.44.2",
    "mastra": "^1.38.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright": "^1.65.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.2.0"
  },
  "packageManager": "pnpm@12.18.0"
}
