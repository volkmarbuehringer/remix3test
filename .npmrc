public-hoist-pattern[]=@remix-run/*
node-version=26.2.0
allowed-versions.typescript-paths=7
allowed-versions.@ai-sdk/provider-utils=4
allowed-versions.@ai-sdk/ui-utils=4

# `github:` deps fetch the whole remix monorepo tarball and run a nested
# `pnpm install` to prepare it. The nested prepare can exceed pnpm defaults
# (fetch-timeout=60000ms, fetch-retries=2) and surface as TimeoutError.
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
