public-hoist-pattern[]=@remix-run/*
node-version=26.2.0
allowed-versions.typescript-paths=7
allowed-versions.@ai-sdk/provider-utils=4
allowed-versions.@ai-sdk/ui-utils=4

# Remix preview installs fetch release assets from
# github.com/remix-run/previews (pre-2026-11-04 retained tarballs came from
# raw.githubusercontent.com; pre-2026-11-03 `github:` pins also ran a nested
# prepare install). Keep the timeouts/retries above pnpm's defaults
# (fetch-timeout=60000ms, fetch-retries=2) for slow tarball or codeload responses.
fetch-timeout=600000
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
