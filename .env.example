# REQUIRED: Generate a strong random secret with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
# SESSION_SECRET=
DATABASE_URL="postgresql://test:password@localhost:5432/newapp"
# # Production: point observability at a dedicated Postgres instance to avoid degrading
# # your application database performance. Falls back to DATABASE_URL when unset.
# OBSERVABILITY_DATABASE_URL=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@localhost
SMTP_USER=
SMTP_PASSWORD=
# Required by /mastra/chat agent and /ai/* routes (opencode-go provider)
# OPENCODE_API_KEY=
# Global rate limit: max requests per IP per minute (applies to all routes except /assets/*)
# GLOBAL_RATE_LIMIT_MAX=500
# Seed user passwords (used when seeding fresh database; fallback to defaults in code)
# SEED_ADMIN_PASSWORD=myyyyAdminP@ss1
# SEED_USER_PASSWORD=myyyUserP@ss1
# Upload storage quotas (bytes; uploads live in the primary database as BYTEA)
# UPLOADS_TOTAL_QUOTA_BYTES=524288000
# UPLOADS_PER_USER_QUOTA_BYTES=104857600
# Retention/TTL cleanups (ms; sweep runs at boot and hourly)
# CHAT_RUNS_TTL_MS=86400000
# WEBHOOK_REQUESTS_RETENTION_MS=2592000000
# AUDIT_LOGS_RETENTION_MS=7776000000
# UPLOADS_RETENTION_MS=7776000000
# DATABASE_MAINTENANCE_INTERVAL_MS=3600000


