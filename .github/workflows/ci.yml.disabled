# Intentionally disabled: GitHub only runs workflows whose filename ends in
# `.yml`/`.yaml`, so `ci.yml.disabled` is inert.
#
# To enable: review the weekly schedule below with the repository owner, then
# rename this file to `.github/workflows/ci.yml`. Do not rename it just to run a
# one-off check; use `workflow_dispatch` after enabling or run the steps locally.
name: CI

on:
  schedule:
    - cron: '0 6 * * 1'  # weekly Monday 6am
  workflow_dispatch:

jobs:
  check:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
        with:
          version: 11.25.0
      - uses: actions/setup-node@v4
        with:
          node-version: 26
          cache: pnpm
          cache-dependency-path: pnpm-lock.yaml

      # Retained preview tarballs are pruned after ~7 days. Run this before the
      # install so an expired pin fails with the refresh instruction instead of
      # an opaque 404 from pnpm.
      - run: npm run remix:pin:check

      - run: pnpm install --frozen-lockfile

      - run: pnpm typecheck
      - run: pnpm lint
      - run: pnpm test
