{
  "$schema": "https://opencode.ai/config.json",

  "agent": {
    "code-reviewer": {
      "model": "opencode-go/glm-5.2"
    }
  },

  "command": {
    "remember": {
      "description": "Save a successful fix or solution as project knowledge with auto-tagging and instinct creation",
      "template": "{file:.opencode/commands/remember.md}\n\n$ARGUMENTS"
    },
    "knowledge": {
      "description": "List, filter, archive, or delete project knowledge files",
      "template": "{file:.opencode/commands/knowledge.md}\n\n$ARGUMENTS"
    }
  },
  "permission": {
  "/home/lucky/remix3test/node_modules/**": {
    "edit": "deny",
    "write": "deny"
  },
  "external_directory": {
    "*": "ask",
    "/home/lucky/.opencode/**": "allow",
    "/home/lucky/remix/**": "allow",
    "/home/lucky/.local/share/ecc-homunculus/**": "allow"
  }
}
  
}
